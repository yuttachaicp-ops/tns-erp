generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("STAFF")
  isActive  Boolean  @default(true)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  photoQueues   PhotoQueue[]
  listingQueues ListingQueue[]
  dailyLogs     DailyLog[]
  activityLogs  ActivityLog[]
  transactions  Transaction[]
  bills         Bill[]
  billPayments  BillPayment[]
  stockCloses  StockClose[]
  @@map("users")
}

model PhotoQueue {
  id           String   @id @default(cuid())
  productName  String
  sku          String?
  category     String?
  quantity     Int      @default(1)
  receivedDate DateTime @default(now())
  status       String   @default("PENDING")
  note         String?
  createdBy    String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user User @relation(fields: [createdBy], references: [id])
  @@map("photo_queue")
}

model ListingQueue {
  id          String   @id @default(cuid())
  productName String
  sku         String?
  platform    String   @default("SHOPEE")
  quantity    Int      @default(1)
  status      String   @default("PENDING")
  assignedTo  String?
  note        String?
  createdBy   String
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  user User @relation(fields: [createdBy], references: [id])
  @@map("listing_queue")
}

model DailyLog {
  id           String   @id @default(cuid())
  workTitle    String
  workDetail   String?
  workCategory String   @default("general")
  priority     String   @default("MEDIUM")
  status       String   @default("TODO")
  assignedUser String?
  workDate     DateTime @default(now())
  workTime     String?
  createdBy    String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  user User @relation(fields: [createdBy], references: [id])
  @@map("daily_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  detail    String?
  userId    String
  ipAddress String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@map("activity_logs")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [createdBy], references: [id])
  @@map("transactions")
}

model Bill {
  id        String        @id @default(cuid())
  name      String
  amount    Float
  dueDay    Int
  category  String        @default("อื่นๆ")
  note      String?
  createdBy String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [createdBy], references: [id])
  payments  BillPayment[]
  @@map("bills")
}

model BillPayment {
  id        String   @id @default(cuid())
  billId    String
  month     String
  paidAt    DateTime @default(now())
  createdBy String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [createdBy], references: [id])
  @@unique([billId, month])
  @@map("bill_payments")
}

model StockClose {
  id           String   @id @default(cuid())
  productName  String
  sku          String?
  category     String?
  platform     String   @default("ALL")
  quantity     Int      @default(0)
  reason       String   @default("หมดสต็อก")
  status       String   @default("PENDING")
  notifiedDate DateTime @default(now())
  note         String?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [createdBy], references: [id])
  @@map("stock_close")
}