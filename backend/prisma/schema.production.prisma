generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum PhotoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ListingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Platform {
  SHOPEE
  LAZADA
  TIKTOK_SHOP
  WEBSITE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  photoQueues     PhotoQueue[]
  listingQueues   ListingQueue[]
  dailyLogs       DailyLog[]
  activityLogs    ActivityLog[]
  transactions    Transaction[]
  bills           Bill[]
  billPayments    BillPayment[]
  stockCloses     StockClose[]
  catProfile      CatProfile?
  catDailyLogs    CatDailyLog[]
  catVetVisits    CatVetVisit[]
  catVaccinations CatVaccination[]
  cats            Cat[]
  mortgages       Mortgage[]
  @@map("users")
}

model PhotoQueue {
  id           String      @id @default(cuid())
  productName  String
  sku          String?
  category     String?
  quantity     Int         @default(1)
  receivedDate DateTime    @default(now())
  status       PhotoStatus @default(PENDING)
  note         String?
  createdBy    String
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())
  user User @relation(fields: [createdBy], references: [id])
  @@map("photo_queue")
}

model ListingQueue {
  id          String        @id @default(cuid())
  productName String
  sku         String?
  platform    Platform
  quantity    Int           @default(1)
  status      ListingStatus @default(PENDING)
  assignedTo  String?
  note        String?
  createdBy   String
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
  user User @relation(fields: [createdBy], references: [id])
  @@map("listing_queue")
}

model DailyLog {
  id           String     @id @default(cuid())
  workTitle    String
  workDetail   String?
  workCategory String     @default("ทั่วไป")
  priority     Priority   @default(MEDIUM)
  status       WorkStatus @default(TODO)
  assignedUser String?
  workDate     DateTime   @default(now())
  workTime     String?
  createdBy    String
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())
  user User @relation(fields: [createdBy], references: [id])
  @@map("daily_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  detail    String?
  userId    String
  ipAddress String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@map("activity_logs")
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  amount      Float
  category    String
  description String?
  date        DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [createdBy], references: [id])
  @@map("transactions")
}

model Bill {
  id        String        @id @default(cuid())
  name      String
  amount    Float
  dueDay    Int
  category  String        @default("อื่นๆ")
  note      String?
  createdBy String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [createdBy], references: [id])
  payments  BillPayment[]
  @@map("bills")
}

model BillPayment {
  id        String   @id @default(cuid())
  billId    String
  month     String
  paidAt    DateTime @default(now())
  createdBy String
  bill      Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [createdBy], references: [id])
  @@unique([billId, month])
  @@map("bill_payments")
}

model StockClose {
  id           String   @id @default(cuid())
  productName  String
  sku          String?
  category     String?
  platform     String   @default("ALL")
  quantity     Int      @default(0)
  reason       String   @default("หมดสต็อก")
  status       String   @default("PENDING")
  notifiedDate DateTime @default(now())
  note         String?
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [createdBy], references: [id])
  @@map("stock_close")
}

model CatProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("")
  age       String?
  gender    String?
  breed     String?
  weight    Float?
  diagnosis String?
  clinic    String?
  doctor    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  @@map("cat_profiles")
}

model Cat {
  id        String   @id @default(cuid())
  userId    String
  name      String
  breed     String?
  color     String?
  birthDate String?
  weight    String?
  microchip String?
  allergy   String?
  note      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  catDailyLogs    CatDailyLog[]
  catVetVisits    CatVetVisit[]
  catVaccinations CatVaccination[]
  @@map("cats")
}

model CatDailyLog {
  id          String   @id @default(cuid())
  userId      String
  catId       String
  logDate     DateTime @default(now())
  medicine    String?
  foodIntake  String?
  waterIntake String?
  excretion   String?
  behavior    String?
  temperature Float?
  weight      Float?
  symptoms    String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
  cat         Cat      @relation(fields: [catId], references: [id])
  @@map("cat_daily_logs")
}

model CatVetVisit {
  id               String   @id @default(cuid())
  userId           String
  catId            String
  visitDate        DateTime @default(now())
  results          String?
  bloodValues      String?
  additionalDiag   String?
  medicationChange String?
  cost             Float?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  cat              Cat      @relation(fields: [catId], references: [id])
  @@map("cat_vet_visits")
}

model CatVaccination {
  id          String    @id @default(cuid())
  userId      String
  catId       String
  vaccineName String
  vacDate     DateTime  @default(now())
  nextDate    DateTime?
  clinic      String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  cat         Cat       @relation(fields: [catId], references: [id])
  @@map("cat_vaccinations")
}
model Mortgage {
  id                String   @id @default(cuid())
  userId            String
  name              String
  bankName          String?
  totalAmount       Float
  monthlyPayment    Float
  totalInstallments Int
  paidInstallments  Int      @default(0)
  startDate         String?
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
  @@map("mortgages")
}
